{{!
    @template block_delta_visualizations/partials/filter

    Displays a single-course selector and date-range filter controls.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * courses - Available courses, each containing id and name.
    * startdate - Initial start date in YYYY-MM-DD format.
    * enddate - Initial end date in YYYY-MM-DD format.

    Example context (json):
    {
        "courses": [
            {
                "id": 2,
                "name": "Introduction to Moodle"
            },
            {
                "id": 5,
                "name": "Advanced Teaching"
            }
        ],
        "startdate": "2026-01-01",
        "enddate": "2026-01-31"
    }
}}

<div class="d-flex align-items-center gap-4 pb-4">
  <span class="mr-4 fs-4 text-nowrap">Select courses:</span>

  <select id="course-select-{{uniqid}}" class="form-select" name="courseid">
    {{#courses}}
      <option value="{{id}}">
        {{name}}
      </option>
    {{/courses}}
  </select>
</div>

<div class="d-flex align-items-center gap-4 pt-2">
  <div class="d-flex align-items-center">
    <span class="mr-3 fs-4 text-nowrap">Start:</span>
    <input id="start-date-select-{{uniqid}}" class="form-control" type="date" name="startdate" value="{{startdate}}">
  </div>
  <div class="d-flex align-items-center">
    <span class="mr-3 fs-4 text-nowrap">End:</span>
    <input id="end-date-select-{{uniqid}}" class="form-control" type="date" name="enddate" value="{{enddate}}">
  </div>

  <div class="d-flex align-items-center ml-auto">
    <div class="d-flex align-items-center">
      <button id="apply-date-filter-{{uniqid}}" type="button" class="btn btn-primary mr-2">Apply</button>
    </div>

    <div class="d-flex align-items-center">
      <button id="reset-date-filter-{{uniqid}}" type="button" class="btn btn-secondary mr-2">Clear</button>
    </div>
  </div>
</div>
