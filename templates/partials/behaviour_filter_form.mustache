{{!
    @template block_delta_visualizations/partials/behaviour_filter_form

    Displays the report-period select filter.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-region="behaviour-filter" - Identifies forms handled by chart refreshing.
    * data-context-id - Supplies the Moodle context ID for the fragment request.
    * data-course-ids - Supplies the selected course IDs as JSON.

    Context variables required for this template:
    * contextid - Moodle context ID for the fragment request.
    * courseidsjson - Selected course IDs encoded as JSON.
    * label - Human-readable field label.
    * options - Select options.

    Example context (json):
    {
        "contextid": 42,
        "courseidsjson": "[2,5]",
        "label": "Reporting period",
        "options": [
            {
                "value": "weekly",
                "label": "Last 7 days",
                "selected": true
            },
            {
                "value": "monthly",
                "label": "Last month",
                "selected": false
            }
        ]
    }
}}

<form class="d-flex align-items-center flex-wrap gap-4" data-region="behaviour-filter" data-context-id="{{contextid}}" data-course-ids="{{courseidsjson}}">
  <div class="d-flex align-items-center">
    <label for="behaviour-filter-time-range-{{uniqid}}" class="mr-3 text-nowrap">
      {{label}}
    </label>

    <select id="behaviour-filter-time-range-{{uniqid}}" class="custom-select" name="filtervalue">
      {{#options}}
        <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
      {{/options}}
    </select>
  </div>

  <button type="submit" class="btn btn-primary">
    {{#str}} apply, block_delta_visualizations {{/str}}
  </button>
</form>
