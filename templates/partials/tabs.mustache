{{!
    @template block_delta_visualizations/instructor_dashboard

    Template purpose and description.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * none

    Example context (json):
    {
    }
}}

<div id="tabs-{{uniqid}}-tab-container">
    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item" role="presentation">
            <a href="#tabs-{{uniqid}}-tab1" class="nav-link active" role="tab" data-target="tabs-{{uniqid}}-tab1" aria-selected="true">
              {{tabs.0.name}}
            </a>
        </li>
        <li class="nav-item" role="presentation">
            <a href="#tabs-{{uniqid}}-tab2" class="nav-link" role="tab" data-target="tabs-{{uniqid}}-tab2" aria-selected="false">
              {{tabs.1.name}}
            </a>
        </li>
    </ul>

    <div class="tab-content border border-top-0 p-3">
        <div role="tabpanel" class="tab-pane active show" id="tabs-{{uniqid}}-tab1">
          <div class="pb-3">
            <h3 style="color: #016630">Support Student Success</h3>
            {{#teacher_behaviours}}
            {{#studentsuccess}}
              {{> block_delta_visualizations/partials/behaviour_block }}
            {{/studentsuccess}}
            {{/teacher_behaviours}}
          </div>
          <div>
            <h3 style="color: #9f0712">Do Not Support Student Success</h3>
            {{#teacher_behaviours}}
            {{^studentsuccess}}
              {{> block_delta_visualizations/partials/behaviour_block }}
            {{/studentsuccess}}
            {{/teacher_behaviours}}
          </div>
        </div>
        <div role="tabpanel" class="tab-pane" id="tabs-{{uniqid}}-tab2">
          <div class="pb-3">
            <h3 style="color: #016630">Behaviours Supporting Student Success</h3>
            {{#student_behaviours}}
            {{#studentsuccess}}
              {{> block_delta_visualizations/partials/behaviour_block }}
            {{/studentsuccess}}
            {{/student_behaviours}}
          </div>
          <div>
            <h3 style="color: #9f0712">Do Not Support Student Success</h3>
            {{#student_behaviours}}
            {{^studentsuccess}}
              {{> block_delta_visualizations/partials/behaviour_block }}
            {{/studentsuccess}}
            {{/student_behaviours}}
          </div>
        </div>
    </div>
</div>

{{#js}}
require(['block_delta_visualizations/tabs'], function(tabs) {
    tabs.init('tabs-{{uniqid}}-tab-container');
});
{{/js}}
