{{!
    @template block_delta_visualizations/partials/tabs

    Displays teacher and student behaviours in two accessible tab panels.

    Classes required for JS:
    * active - Marks the selected tab and panel.
    * show - Makes the selected panel visible.

    Data attributes required for JS:
    * data-target - Connects each tab to its panel ID.

    Context variables required for this template:
    * tabs - Two tab entries, each containing a name.
    * teacher_behaviours - Teacher behaviours containing name, studentsuccess, and chart.
    * student_behaviours - Student behaviours containing name, studentsuccess, and chart.

    Example context (json):
    {
        "tabs": [
            {
                "name": "Instructor Behaviour"
            },
            {
                "name": "Instructor View of Student Behaviour"
            }
        ],
        "teacher_behaviours": [
            {
                "name": "Timely Feedback",
                "studentsuccess": true,
                "chart": "<div class=\"alert alert-info\">Example supporting teacher chart</div>"
            },
            {
                "name": "Monitoring Forums",
                "studentsuccess": false,
                "chart": "<div class=\"alert alert-info\">Example non-supporting teacher chart</div>"
            }
        ],
        "student_behaviours": [
            {
                "name": "Login Frequency",
                "studentsuccess": true,
                "chart": "<div class=\"alert alert-info\">Example supporting student chart</div>"
            },
            {
                "name": "Forum Posting Frequency",
                "studentsuccess": false,
                "chart": "<div class=\"alert alert-info\">Example non-supporting student chart</div>"
            }
        ]
    }
}}

<div id="tabs-{{uniqid}}-tab-container">
    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item" role="presentation">
            <a href="#tabs-{{uniqid}}-tab1" class="nav-link active" role="tab" data-target="tabs-{{uniqid}}-tab1" aria-selected="true">
              {{tabs.0.name}}
            </a>
        </li>
        <li class="nav-item" role="presentation">
            <a href="#tabs-{{uniqid}}-tab2" class="nav-link" role="tab" data-target="tabs-{{uniqid}}-tab2" aria-selected="false">
              {{tabs.1.name}}
            </a>
        </li>
    </ul>

    <div class="tab-content border border-top-0 p-3">
        <div role="tabpanel" class="tab-pane active show" id="tabs-{{uniqid}}-tab1">
          <div class="pb-3">
            <h3 style="color: #016630">Support Student Success</h3>
            {{#teacher_behaviours}}
            {{#studentsuccess}}
              {{> block_delta_visualizations/partials/behaviour_block }}
            {{/studentsuccess}}
            {{/teacher_behaviours}}
          </div>
          <div>
            <h3 style="color: #9f0712">Do Not Support Student Success</h3>
            {{#teacher_behaviours}}
            {{^studentsuccess}}
              {{> block_delta_visualizations/partials/behaviour_block }}
            {{/studentsuccess}}
            {{/teacher_behaviours}}
          </div>
        </div>
        <div role="tabpanel" class="tab-pane" id="tabs-{{uniqid}}-tab2">
          <div class="pb-3">
            <h3 style="color: #016630">Support Student Success</h3>
            {{#student_behaviours}}
            {{#studentsuccess}}
              {{> block_delta_visualizations/partials/behaviour_block }}
            {{/studentsuccess}}
            {{/student_behaviours}}
          </div>
          <div>
            <h3 style="color: #9f0712">Do Not Support Student Success</h3>
            {{#student_behaviours}}
            {{^studentsuccess}}
              {{> block_delta_visualizations/partials/behaviour_block }}
            {{/studentsuccess}}
            {{/student_behaviours}}
          </div>
        </div>
    </div>
</div>

{{#js}}
require(['block_delta_visualizations/tabs'], function(tabs) {
    tabs.init('tabs-{{uniqid}}-tab-container');
});
{{/js}}
